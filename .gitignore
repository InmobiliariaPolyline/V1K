# Copias de trabajo de los repos de las apps: son repositorios aparte (ver README).
# Si las subes aquí quedarían como repos anidados y con su propio historial.
/apps/

# Dependencias y compilados
node_modules/
.vercel/

# Secretos: nunca al repositorio
.env
.env.*
!.env.example
*.pem
secrets.toml
!secrets.toml.example

# Entorno virtual de Python y cachés de las baterías
.venv/
__pycache__/

# Archivos del sistema y del editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Contraseñas generadas en local: nunca al repositorio
*.local.sql
*.local.txt

# Resultados de la vigilancia (scripts/vigilancia.mjs)
/coze-api/incidencia.md
/coze-api/vigilancia.json
